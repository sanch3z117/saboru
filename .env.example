# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio.

# Supabase (Fase 1+). La service role solo se usa en el servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origen canónico de la app (magic links y redirects).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Modo demo de correo (Fase 8.1). Solo en Preview/demo. Si vale exactamente
# "true", /registro acepta cualquier correo; sin la variable o con "false"
# se mantiene @uptc.edu.co. Nunca lo definas en Production ni lo prefijes
# con NEXT_PUBLIC_: es una bandera de servidor.
# DEMO_ALLOW_ANY_EMAIL=true

# Mapa (Fase 7.5.1). Es una clave pública de cliente. Sin clave se usa OSM
# raster con atribución; el mapa siempre es online-only.
NEXT_PUBLIC_MAPTILER_KEY=

# Conexión directa a Postgres para pruebas de integración.
# Local por defecto: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# Rate limit (Fase 3+). En local se puede desactivar sin claves de Upstash:
# RATE_LIMIT_DISABLED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
