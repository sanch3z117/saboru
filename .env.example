# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio.

# Supabase (Fase 1+). La service role solo se usa en el servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origen canónico de la app (magic links y redirects).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Conexión directa a Postgres para pruebas de integración.
# Local por defecto: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# Rate limit (Fase 3+). En local se puede desactivar sin claves de Upstash:
# RATE_LIMIT_DISABLED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
